# /opt/acc/.env on the VM. Never commit the real file.

# Image tag deployed by CI (a commit SHA); `latest` for manual runs.
ACC_TAG=latest

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://acc:change-me@postgres:5432/acc
REDIS_URL=redis://redis:6379

# Cloudflare R2 (S3 API). Test data bucket for the app, backup bucket for dumps.
STORAGE_URL=s3://acc-data
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=acc-backups

# Public site, used in mail links.
WEB_URL=https://acc.example.com
# Same value as the Pages project's INTERNAL_TOKEN secret.
INTERNAL_TOKEN=
TRUST_CLOUDFLARE=1
SECURE_COOKIES=1

# Mail through Resend.
RESEND_API_KEY=
MAIL_FROM=acc <no-reply@acc.example.com>

# Discord webhook for downtime, judge errors, typo reports, review requests, backups.
ALERT_WEBHOOK_URL=

# Refuse submissions while the queue is longer than this. Set it from
# scripts/loadtest.sh on the VM: throughput × the longest acceptable wait.
QUEUE_LIMIT=500
# Submissions judged at once (go-judge sandboxes = worker slots).
JUDGE_PARALLELISM=3
ADMIN_HANDLES=regx64

CLOUDFLARE_TUNNEL_TOKEN=

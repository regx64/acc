# Local development. Copy to .env and `set -a; . ./.env; set +a` before
# running cargo, or use `just`-style scripts of your own.
DATABASE_URL=postgres://acc:acc@127.0.0.1:5432/acc
REDIS_URL=redis://127.0.0.1:6379
STORAGE_URL=s3://acc
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=acc
AWS_SECRET_ACCESS_KEY=acc-dev-secret
AWS_REGION=us-east-1
AWS_ALLOW_HTTP=true
# Worker cache: the worker writes ./var/cache, go-judge sees it as /var/cache/acc.
CACHE_DIR=./var/cache
JUDGE_CACHE_DIR=/var/cache/acc
GO_JUDGE_URL=http://127.0.0.1:5050
GO_JUDGE_PATH=/usr/local/rust-bin:/usr/local/bin:/usr/bin:/bin
BIND=127.0.0.1:8080
WEB_URL=http://localhost:5173
INTERNAL_TOKEN=dev-internal-token
SECURE_COOKIES=0
ADMIN_HANDLES=regx64
WORKER_CONCURRENCY=2
RUST_LOG=info
